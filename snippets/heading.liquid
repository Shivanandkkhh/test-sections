{%- liquid
  assign base_style = ''
  if font_size != blank
    assign base_style = base_style | append: 'font-size:' | append: font_size | append: 'px;'
  endif
  if color != blank
    assign base_style = base_style | append: 'color:' | append: color | append: ';'
  endif
-%}
<div class="heading heading--{{ block.id }}">
  <h1{% if base_style != blank %} style="{{ base_style }}"{% endif %}>{{ heading }}</h1>
</div>

{%- if font_size_mobile != blank -%}
  <style>
    @media (max-width: 749px) {
      .heading--{{ block.id }} h1 {
        font-size: {{ font_size_mobile }}px !important;
      }
    }
  </style>
{%- endif -%}
