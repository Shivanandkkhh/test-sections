{%- liquid
  assign line_height_ratio = 1.2

  assign base_style = ''
  if font_size != blank
    assign line_height = font_size | times: line_height_ratio
    assign base_style = base_style | append: 'font-size:' | append: font_size | append: 'px;'
    assign base_style = base_style | append: 'line-height:' | append: line_height | append: 'px;'
  endif
  if color != blank
    assign base_style = base_style | append: 'color:' | append: color | append: ';'
  endif
-%}
<div class="heading heading--{{ block.id }}">
  <h1{% if base_style != blank %} style="{{ base_style }}"{% endif %}>{{ heading }}</h1>
</div>

{%- if font_size_mobile != blank -%}
  {%- assign line_height_mobile = font_size_mobile | times: line_height_ratio -%}
  <style>
    @media (max-width: 749px) {
      .heading--{{ block.id }} h1 {
        font-size: {{ font_size_mobile }}px !important;
        line-height: {{ line_height_mobile }}px !important;
      }
    }
  </style>
{%- endif -%}
