<div class="heading heading--{{ block.id }}">
  {% render 'heading',
    block: block,
    heading: block.settings.heading,
    font_size: block.settings.font_size,
    font_size_mobile: block.settings.font_size_mobile,
    color: block.settings.color
  %}
</div>

{% schema %}
{
  "name": "heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 112,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size Mobile",
      "min": 12,
      "max": 112,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Heading"
    }
  ]
}
{% endschema %}
