<div class="hero-image hero-image--{{ block.id }}">
    <div class="hero-image__content relative">
        <div class="hero-image__heading absolute z-[9] text-white bottom-8 left-8">
            {% content_for 'blocks' %}
        </div>
        <div class="hero-image__image">
            {% render 'image', desktop_image: block.settings.image, mobile_image: block.settings.mobile_image, image_id: block.id ,desktop_aspect_ratio: block.settings.desktop_aspect_ratio, mobile_aspect_ratio: block.settings.mobile_aspect_ratio %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Hero Image",
    "blocks": [{"type": "@theme"}],
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "range",
            "id": "desktop_aspect_ratio",
            "label": "Desktop Aspect Ratio",
            "min": 0,
            "max": 5,
            "step": 0.1,
            "default": 1
        },
        {
            "type" : "image_picker",
            "id": "mobile_image",
            "label": "Mobile Image"
        },
        {
            "type": "range",
            "id": "mobile_aspect_ratio",
            "label": "Mobile Aspect Ratio",
            "min": 0,
            "max": 5,
            "step": 0.1,
            "default": 1
        }
    ],
    "presets": [
        {
            "name": "Hero Image"
        }
    ]
}
{% endschema %}